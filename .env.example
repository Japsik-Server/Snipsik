# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Turso (LibSQL) Database Configuration
# Remote: libsql://your-database-org.turso.io (requires DATABASE_AUTH_TOKEN)
# Local development/testing: file:local.db or file::memory:
DATABASE_URL=libsql://your-database-org.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token_here

# Sink Link Shortener Instance Configuration
SINK_BASE_URL=https://s.japsik.com
SINK_API_TOKEN=your_sink_nuxt_site_token_here
SINK_REQUEST_TIMEOUT_MS=10000

# Optional Configurations
RANDOM_SLUG_LENGTH=3
ADMIN_USER_IDS=294123456789012345,123456789012345678
